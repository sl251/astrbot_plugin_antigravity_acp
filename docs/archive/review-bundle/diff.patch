+class UpstreamState(str, Enum):
+    UNKNOWN = "UNKNOWN"
+    ACCOUNT_QUOTA_EXHAUSTED = "ACCOUNT_QUOTA_EXHAUSTED"
+    RATE_LIMIT_OR_CAPACITY = "RATE_LIMIT_OR_CAPACITY"
